{
  "hosting": [
    {
      "target": "portfolio",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
      ]
    },
    {
      "target": "legacy",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        { "source": "/", "destination": "https://webfolio-showcase-2026.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://webfolio-showcase-2026.web.app/:path", "type": 301 }
      ]
    }
  ]
}